# Copy to .env (gitignored) for local development. TEST MODE ONLY.
NODE_ENV=local
PORT=4000
# LOG_LEVEL=debug

# Matches docker-compose.yml (local-only credentials)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=talkpay
DATABASE_PASSWORD=talkpay
DATABASE_NAME=talkpay
# Migrations own the schema. Sync is ignored unless NODE_ENV=local, and stays false even there.
DATABASE_SYNC=false
